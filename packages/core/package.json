{
  "name": "@leoupload/core",
  "version": "0.1.2",
  "description": "High-performance file upload engine with breakpoint resume and chunked uploads",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/spark-md5": "^3.0.5",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^15.0.0",
    "msw": "^2.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "upload",
    "file-upload",
    "chunked-upload",
    "resumable-upload",
    "breakpoint-resume",
    "large-file",
    "web-worker"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nefelibatapjb/LeoUpload.git"
  },
  "homepage": "https://github.com/nefelibatapjb/LeoUpload#readme",
  "bugs": {
    "url": "https://github.com/nefelibatapjb/LeoUpload/issues"
  }
}
