{
  "name": "@leoupload/react",
  "version": "0.1.0",
  "description": "React wrapper for LeoUpload — hook and component",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@leoupload/core": "workspace:*",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@leoupload/core": "workspace:*",
    "@types/react": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "react": "^18.3.0"
  },
  "keywords": ["upload", "react", "file-upload", "leoupload"],
  "license": "MIT"
}
