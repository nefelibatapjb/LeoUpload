{
  "name": "@leoupload/solid",
  "version": "0.2.0",
  "description": "SolidJS wrapper for LeoUpload — primitive and component",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@leoupload/core": "workspace:*",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@leoupload/core": "workspace:*",
    "solid-js": "^1.8.0",
    "vite": "^5.4.0",
    "vite-plugin-solid": "^2.10.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "upload",
    "solidjs",
    "solid",
    "file-upload",
    "leoupload"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nefelibatapjb/LeoUpload.git"
  },
  "homepage": "https://github.com/nefelibatapjb/LeoUpload#readme",
  "bugs": {
    "url": "https://github.com/nefelibatapjb/LeoUpload/issues"
  }
}
